RAG_KEYWORD_BACKEND=memory

# Query planning: heuristic, llm, or auto. Auto uses LLM only when an API key is configured.
RAG_QUERY_PLANNER_MODE=auto
RAG_PLANNER_MODEL=gpt-4o-mini
# RAG_PLANNER_API_KEY=
# RAG_PLANNER_BASE_URL=https://api.openai.com/v1
RAG_PLANNER_TEMPERATURE=0
RAG_PLANNER_REQUEST_TIMEOUT=30
RAG_PLANNER_MAX_RETRIES=2
RAG_PLANNER_MINIMUM_CONFIDENCE=0.55
RAG_PLANNER_MAX_REWRITES=4

# Set RAG_KEYWORD_BACKEND=elasticsearch to enable the persistent BM25 adapter.
RAG_ELASTICSEARCH_URL=http://localhost:9200
RAG_ELASTICSEARCH_INDEX=rag_chunks
RAG_ELASTICSEARCH_VERIFY_CERTS=true
RAG_ELASTICSEARCH_REQUEST_TIMEOUT=10
RAG_ELASTICSEARCH_ANALYZER=standard
RAG_ELASTICSEARCH_BM25_K1=1.2
RAG_ELASTICSEARCH_BM25_B=0.75

# Choose API-key authentication or username/password authentication.
# RAG_ELASTICSEARCH_API_KEY=
# RAG_ELASTICSEARCH_USERNAME=
# RAG_ELASTICSEARCH_PASSWORD=

RAG_HYBRID_CANDIDATE_MULTIPLIER=2
RAG_RRF_RANK_CONSTANT=60
