RAG_KEYWORD_BACKEND=memory
# Versioned JSON preset; environment and .env values override its settings.
# RAG_SERVICE_PRESET=docs/preset.local.json
# P1: hash (offline), compatible (remote), auto (initial choice; no runtime fallback).
RAG_EMBEDDING_MODE=hash
RAG_EMBEDDING_DIMENSIONS=384
RAG_EMBEDDING_BATCH_SIZE=10
RAG_EMBEDDING_REQUEST_TIMEOUT=30
RAG_EMBEDDING_SEND_DIMENSIONS=true
# For remote embeddings, set all three below and a supported dimension.
# RAG_EMBEDDING_MODEL=text-embedding-v3
# RAG_EMBEDDING_BASE_URL=https://your-provider/compatible-mode/v1
# RAG_EMBEDDING_API_KEY=replace-me
# RAG_EMBEDDING_MODEL_REVISION=deployment-version
RAG_VECTOR_BACKEND=chroma
RAG_CHUNKER_MODE=character
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=120
RAG_FUSION_MODE=rrf
# When set, overrides legacy RAG_RRF_RANK_CONSTANT.
# RAG_FUSION_RANK_CONSTANT=60
# With RAG_QUERY_PLANNER_MODE=disabled: no analysis or rewrite.
RAG_DEFAULT_RETRIEVAL_STRATEGY=hybrid
RAG_DEFAULT_RETRIEVAL_RERANK=true
RAG_SOURCE_DIRECTORY=data/sources
RAG_KNOWLEDGE_BASE_DIRECTORY=data/knowledge_bases

# disabled | cross_encoder | cloud | auto
RAG_RERANKER_MODE=cloud
RAG_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
RAG_RERANKER_DEVICE=cpu
RAG_RERANKER_BATCH_SIZE=16
RAG_RERANKER_CANDIDATE_K=32
RAG_RERANKER_LOCAL_FILES_ONLY=true

# Cloud rerank. API key falls back to RAG_PLANNER_API_KEY when omitted.
RAG_RERANKER_CLOUD_PROTOCOL=dashscope
RAG_RERANKER_CLOUD_MODEL=gte-rerank-v2
RAG_RERANKER_CLOUD_URL=https://dashscope.aliyuncs.com/api/v1/services/rerank/text-rerank/text-rerank
RAG_RERANKER_CLOUD_API_KEY=your-dashscope-api-key
RAG_RERANKER_CLOUD_TIMEOUT=30
# RAG_RERANKER_CLOUD_INSTRUCT=

# Query planning: heuristic, llm, or auto. Auto uses LLM only when an API key is configured.
RAG_QUERY_PLANNER_MODE=auto
RAG_PLANNER_MODEL=gpt-4o-mini
# RAG_PLANNER_API_KEY=
# RAG_PLANNER_BASE_URL=https://api.openai.com/v1
RAG_PLANNER_TEMPERATURE=0
RAG_PLANNER_REQUEST_TIMEOUT=30
RAG_PLANNER_MAX_RETRIES=2
RAG_PLANNER_MINIMUM_CONFIDENCE=0.55
RAG_PLANNER_MAX_REWRITES=4

# Answer generation reuses Planner credentials when these values are omitted.
RAG_ANSWER_GENERATOR_MODE=auto
# RAG_GENERATION_MODEL=
# RAG_GENERATION_API_KEY=
# RAG_GENERATION_BASE_URL=
RAG_GENERATION_TEMPERATURE=0.2
RAG_GENERATION_REQUEST_TIMEOUT=60
RAG_GENERATION_MAX_RETRIES=2
RAG_GENERATION_MAX_TOKENS=1024
RAG_GENERATION_MAX_CONTEXT_CHUNKS=8

RAG_EVALUATION_CONCURRENCY=4
RAG_EVALUATION_REPORT_LIMIT=100
RAG_EVALUATION_REPORT_DIRECTORY=data/evaluation/reports
RAG_EVALUATION_DATASET_DIRECTORY=data/evaluation/datasets
RAG_EVALUATION_DATASET_MAX_CASES=10000
RAG_EVALUATION_DATASET_MAX_BYTES=5000000

# Answer quality judge: heuristic, llm, or auto. LLM settings fall back to generation/planner.
RAG_EVALUATION_JUDGE_MODE=heuristic
# RAG_EVALUATION_JUDGE_MODEL=
# RAG_EVALUATION_JUDGE_API_KEY=
# RAG_EVALUATION_JUDGE_BASE_URL=
RAG_EVALUATION_JUDGE_TEMPERATURE=0
RAG_EVALUATION_JUDGE_REQUEST_TIMEOUT=60
RAG_EVALUATION_JUDGE_MAX_RETRIES=2
RAG_EVALUATION_JUDGE_MAX_TOKENS=1024
RAG_EVALUATION_JUDGE_MAX_CONTEXT_CHARACTERS=12000

# Set RAG_KEYWORD_BACKEND=elasticsearch to enable the persistent BM25 adapter.
RAG_ELASTICSEARCH_URL=http://localhost:9200
RAG_ELASTICSEARCH_INDEX=rag_chunks
RAG_ELASTICSEARCH_VERIFY_CERTS=true
RAG_ELASTICSEARCH_REQUEST_TIMEOUT=10
RAG_ELASTICSEARCH_ANALYZER=standard
RAG_ELASTICSEARCH_BM25_K1=1.2
RAG_ELASTICSEARCH_BM25_B=0.75

# Choose API-key authentication or username/password authentication.
# RAG_ELASTICSEARCH_API_KEY=
# RAG_ELASTICSEARCH_USERNAME=
# RAG_ELASTICSEARCH_PASSWORD=

RAG_HYBRID_CANDIDATE_MULTIPLIER=2
RAG_RRF_RANK_CONSTANT=60
